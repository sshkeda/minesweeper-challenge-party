{"t":1788507992732,"kind":"tool_call","guest":"Luna-1","tool":"edit_tool","input":{"name":"smart_solver","description":"Solve Minesweeper with deterministic constraint propagation and a safe opening.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"code":"if (game.summary().moves===0) game.reveal(4,4); let actions=[]; for(let pass=0;pass<200;pass++){let v=game.view(),safe=new Set(),mines=new Set(); for(let r=0;r<game.rows;r++)for(let c=0;c<game.cols;c++){let x=v[r][c];if(!/^[0-8]$/.test(x))continue;let hid=[],fl=0;for(let [rr,cc] of game.neighbors(r,c)){let y=v[rr][cc];if(y==='F')fl++;else if(y==='#')hid.push([rr,cc]);}let d=+x-fl;if(hid.length&&d===0)for(let p of hid)safe.add(p.join(','));if(hid.length&&d===hid.length)for(let p of hid)mines.add(p.join(','));} for(let k of mines){let [r,c]=k.split(',').map(Number);if(game.view()[r][c]==='#'){game.toggleFlag(r,c);actions.push('F'+r+','+c);}} for(let k of safe){let [r,c]=k.split(',').map(Number);if(game.view()[r][c]==='#'){let z=game.reveal(r,c);actions.push('G'+r+','+c);if(z.hitMine)return {...game.summary(),actions,board:game.text()};}}let s=game.summary();if(s.status!=='playing'||s.cellsLeft===0)return {...s,actions,board:game.text()};if(!safe.size&&!mines.size){let p=null;for(let r=0;r<game.rows&&!p;r++)for(let c=0;c<game.cols;c++)if(game.view()[r][c]==='#'){p=[r,c];break;}if(!p)break;let z=game.reveal(p[0],p[1]);actions.push('G'+p[0]+','+p[1]);if(z.hitMine)return {...game.summary(),actions,board:game.text()};}}return {...game.summary(),actions,board:game.text()};"},"result":{"ok":true,"saved":"smart_solver","memoId":17,"note":"Tool is live now for you and every future guest. The tool list changed: call webmcp_list_tools again."}}
